# Banco (Postgres 16). Migrations rodam como dona; o app usa tributon_app (RLS); o worker, tributon_worker.
DATABASE_URL=postgres://postgres@localhost:55432/tributon
DATABASE_URL_APP=postgres://tributon_app:tributon_app@localhost:55432/tributon
DATABASE_URL_WORKER=postgres://tributon_worker:tributon_worker@localhost:55432/tributon

# Sessão (mínimo 32 caracteres)
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio-de-32+

# Motor oficial (engine/run-engine.sh)
ENGINE_URL=http://localhost:8080/api/calculadora
VERIFY_MUNICIPIO=4314902
VERIFY_UF=RS

# Classificador: jev (padrão) ou fake (testes/demo sem rede)
CLASSIFIER_BACKEND=jev
TYPESAFE_API_KEY=
# Atrás de proxy HTTP(S), o fetch do Node só usa o proxy com isto:
NODE_USE_ENV_PROXY=1
